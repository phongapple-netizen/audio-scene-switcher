<Window x:Class="AudioPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:AudioPanel.Models"
        Title="音频设备切换面板" Width="400" MinWidth="360" SizeToContent="Height" ResizeMode="CanMinimize"
        Background="{StaticResource WindowBackgroundBrush}" Foreground="{StaticResource PrimaryTextBrush}"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        WindowStartupLocation="Manual" ShowInTaskbar="False">
    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- 标题 -->
                <DockPanel Margin="0,0,0,14">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" VerticalAlignment="Center"
                            ToolTip="刷新设备" AutomationProperties.Name="刷新设备"
                            Click="RefreshButton_Click" IsEnabled="{Binding CanRefresh}"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="音频设备切换" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding AppliedSceneText}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>

                <!-- 当前设备 -->
                <TextBlock Text="当前设备" Style="{StaticResource SectionCaption}"/>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE767;" Foreground="{StaticResource SecondaryTextBrush}"
                                   HorizontalAlignment="Left" ToolTip="输出"/>
                        <TextBlock Grid.Column="1" Text="{Binding CurrentOutputText}" ToolTip="{Binding CurrentOutputText}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Style="{StaticResource IconText}" Text="&#xE720;" Foreground="{StaticResource SecondaryTextBrush}"
                                   HorizontalAlignment="Left" Margin="0,8,0,0" ToolTip="输入"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentInputText}" ToolTip="{Binding CurrentInputText}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,8,0,0"/>
                    </Grid>
                </Border>

                <!-- 场景：点击即切换，右上角铅笔编辑 -->
                <TextBlock Text="场景" Style="{StaticResource SectionCaption}"/>
                <ItemsControl ItemsSource="{Binding Scenes}" Margin="-4,-4,-4,8" Focusable="False">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4">
                                <Button Tag="{Binding}" Click="SceneButton_Click" Style="{StaticResource SceneTileStyle}"
                                        AutomationProperties.Name="{Binding Name}" ToolTip="{Binding StateText}"
                                        IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SceneIconStyle}"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding StateText}" Style="{StaticResource SceneStateTextStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource TileEditButton}" Content="&#xE70F;" Tag="{Binding}"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0"
                                        Click="EditSceneButton_Click" ToolTip="编辑此场景的设备"
                                        AutomationProperties.Name="{Binding Name, StringFormat=编辑{0}}"
                                        IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 编辑区（默认折叠） -->
                <ToggleButton Style="{StaticResource SectionToggle}" IsChecked="{Binding IsEditorOpen, Mode=TwoWay}"
                              Content="{Binding SelectedSceneText}" AutomationProperties.Name="展开或收起场景编辑"/>
                <Border x:Name="EditorCard" Style="{StaticResource CardStyle}" Margin="0,4,0,4"
                        Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel IsEnabled="{Binding CanEdit}">
                        <TextBlock Text="{Binding SelectedSceneStateText}" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" Margin="0,0,0,10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"><Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSceneNeedsAttention}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers></Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Text="名称" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="SceneNameBox" Grid.Column="1" Text="{Binding SelectedScene.Name, Mode=OneWay}"
                                     MaxLength="{x:Static models:AudioScene.MaxNameLength}" AutomationProperties.Name="场景名称"
                                     ToolTip="按回车或点别处保存" KeyDown="SceneNameBox_KeyDown" LostKeyboardFocus="SceneNameBox_LostKeyboardFocus"/>
                            <TextBlock Grid.Row="1" Text="输出" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Row="2" Text="输入" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Row="3" Text="摄像头" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="OutputCombo" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding OutputDevices}" ItemTemplate="{StaticResource DeviceItemTemplate}"
                                      SelectedItem="{Binding SelectedOutput, Mode=TwoWay}" SelectionChanged="Output_SelectionChanged" AutomationProperties.Name="输出设备"/>
                            <ComboBox x:Name="InputCombo" Grid.Column="1" Grid.Row="2" ItemsSource="{Binding InputDevices}" ItemTemplate="{StaticResource DeviceItemTemplate}"
                                      SelectedItem="{Binding SelectedInput, Mode=TwoWay}" SelectionChanged="Input_SelectionChanged" AutomationProperties.Name="输入设备"/>
                            <ComboBox x:Name="CameraCombo" Grid.Column="1" Grid.Row="3" ItemsSource="{Binding CameraDevices}" ItemTemplate="{StaticResource DeviceItemTemplate}"
                                      SelectedItem="{Binding SelectedCamera, Mode=TwoWay}" SelectionChanged="Camera_SelectionChanged" AutomationProperties.Name="摄像头"/>
                        </Grid>
                        <CheckBox Content="通信设备跟随普通设备" IsChecked="{Binding FollowCommunicationEndpoint, Mode=TwoWay}"
                                  Checked="FollowCommunication_Changed" Unchecked="FollowCommunication_Changed" Margin="56,2,0,8"/>
                        <Grid Margin="0,2,0,0">
                            <Grid.Style><Style TargetType="Grid"><Style.Triggers>
                                <DataTrigger Binding="{Binding FollowCommunicationEndpoint}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                            </Style.Triggers></Style></Grid.Style>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Text="通信输出" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Row="1" Text="通信输入" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding OutputDevices}" ItemTemplate="{StaticResource DeviceItemTemplate}"
                                      SelectedItem="{Binding SelectedCommunicationOutput, Mode=TwoWay}" SelectionChanged="CommunicationOutput_SelectionChanged" AutomationProperties.Name="通信输出设备"/>
                            <ComboBox Grid.Column="1" Grid.Row="1" ItemsSource="{Binding InputDevices}" ItemTemplate="{StaticResource DeviceItemTemplate}"
                                      SelectedItem="{Binding SelectedCommunicationInput, Mode=TwoWay}" SelectionChanged="CommunicationInput_SelectionChanged" AutomationProperties.Name="通信输入设备"/>
                        </Grid>
                        <TextBlock Text="修改会自动保存，点击场景或下方按钮才切换。名称最多 12 个字。摄像头只记录偏好，需在会议软件中选择。"
                                   Style="{StaticResource HintText}" Margin="0,2,0,12"/>
                        <Button Style="{StaticResource AccentButton}" Content="{Binding ApplyButtonText}" Click="ApplySceneButton_Click"
                                IsEnabled="{Binding CanApplySelectedScene}" Height="36"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 音量与电平 -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="8,8,14,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <Button Style="{StaticResource IconButton}" Click="MuteButton_Click" IsEnabled="{Binding CanAdjustVolume}"
                        ToolTip="{Binding MuteButtonText}" AutomationProperties.Name="{Binding MuteButtonText}">
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE767;"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                        <Setter Property="Text" Value="&#xE74F;"/>
                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
                <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1"
                        Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanAdjustVolume}"
                        ValueChanged="Volume_ValueChanged" VerticalAlignment="Center" Margin="6,0,10,0"
                        ToolTip="系统输出音量" AutomationProperties.Name="系统输出音量"/>
                <TextBlock Grid.Column="2" Text="{Binding VolumeText}" Foreground="{StaticResource SecondaryTextBrush}"
                           MinWidth="38" TextAlignment="Right" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="1" Style="{StaticResource IconText}" Text="&#xE720;" Foreground="{StaticResource TertiaryTextBrush}"
                           Margin="0,6,0,0" ToolTip="麦克风输入电平"/>
                <ProgressBar Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding InputLevel}" IsHitTestVisible="False"
                             VerticalAlignment="Center" Margin="15,6,19,0" AutomationProperties.Name="系统输入电平"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding InputLevelText}" Foreground="{StaticResource TertiaryTextBrush}"
                           MinWidth="38" TextAlignment="Right" VerticalAlignment="Center" Margin="0,6,0,0"/>
            </Grid>
        </Border>

        <!-- 状态 -->
        <StackPanel Grid.Row="2" Margin="2,10,2,0">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="12">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusKind}" Value="{x:Static models:PanelStatusKind.Success}"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/></DataTrigger>
                            <DataTrigger Binding="{Binding StatusKind}" Value="{x:Static models:PanelStatusKind.Warning}"><Setter Property="Foreground" Value="{StaticResource WarningBrush}"/></DataTrigger>
                            <DataTrigger Binding="{Binding StatusKind}" Value="{x:Static models:PanelStatusKind.Error}"><Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding DeviceSummaryText}" Style="{StaticResource HintText}" FontSize="11" Margin="0,3,0,0"/>
        </StackPanel>
    </Grid>
</Window>
