<Window x:Class="AudioPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="音频设备切换面板"
        Width="440" Height="640" MinWidth="400" MinHeight="560"
        Background="{StaticResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">
    <Border Padding="12">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Content="刷新" Click="RefreshButton_Click" Padding="9,4"/>
                    <StackPanel>
                        <TextBlock Text="音频设备切换面板" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="本机设备场景切换" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"/>
                    </StackPanel>
                </DockPanel>

                <Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="输出" Foreground="{StaticResource SecondaryTextBrush}"/>
                        <TextBlock Grid.Row="1" Text="输入" Foreground="{StaticResource SecondaryTextBrush}"/>
                        <TextBlock Grid.Row="2" Text="摄像头" Foreground="{StaticResource SecondaryTextBrush}"/>
                        <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding CurrentOutputText}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding CurrentInputText}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Grid.Row="2" Text="{Binding CurrentCameraText}" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>

                <TextBlock Text="场景" FontWeight="SemiBold" Margin="2,0,0,2"/>
                <ItemsControl ItemsSource="{Binding Scenes}" Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate><Button Content="{Binding Name}" Tag="{Binding}" Click="SceneButton_Click" Height="36"/></DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="设备选择" FontWeight="SemiBold" Margin="2,2,0,2"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <Label Grid.Row="0" Content="输出"/>
                    <Label Grid.Row="1" Content="输入"/>
                    <Label Grid.Row="2" Content="摄像头"/>
                    <ComboBox Grid.Column="1" Grid.Row="0" ItemsSource="{Binding OutputDevices}" ItemTemplate="{StaticResource DeviceItemTemplate}" SelectedItem="{Binding SelectedOutput, Mode=TwoWay}" SelectionChanged="Output_SelectionChanged"/>
                    <ComboBox Grid.Column="1" Grid.Row="1" ItemsSource="{Binding InputDevices}" ItemTemplate="{StaticResource DeviceItemTemplate}" SelectedItem="{Binding SelectedInput, Mode=TwoWay}" SelectionChanged="Input_SelectionChanged"/>
                    <ComboBox Grid.Column="1" Grid.Row="2" ItemsSource="{Binding CameraDevices}" ItemTemplate="{StaticResource DeviceItemTemplate}" SelectedItem="{Binding SelectedCamera, Mode=TwoWay}" SelectionChanged="Camera_SelectionChanged"/>
                </Grid>

                <TextBlock Text="下拉框用于编辑当前场景；点击“应用选中场景”后才会切换系统设备。"
                           Foreground="{StaticResource SecondaryTextBrush}" FontSize="10"
                           TextWrapping="Wrap" Margin="59,2,4,2"/>

                <CheckBox Content="通信端点跟随普通端点" IsChecked="{Binding FollowCommunicationEndpoint, Mode=TwoWay}" Checked="FollowCommunication_Changed" Unchecked="FollowCommunication_Changed"/>

                <Grid Margin="0,0,0,4">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FollowCommunicationEndpoint}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <Label Grid.Row="0" Content="通信输出"/>
                    <Label Grid.Row="1" Content="通信输入"/>
                    <ComboBox Grid.Column="1" Grid.Row="0" ItemsSource="{Binding OutputDevices}" ItemTemplate="{StaticResource DeviceItemTemplate}" SelectedItem="{Binding SelectedCommunicationOutput, Mode=TwoWay}" SelectionChanged="CommunicationOutput_SelectionChanged"/>
                    <ComboBox Grid.Column="1" Grid.Row="1" ItemsSource="{Binding InputDevices}" ItemTemplate="{StaticResource DeviceItemTemplate}" SelectedItem="{Binding SelectedCommunicationInput, Mode=TwoWay}" SelectionChanged="CommunicationInput_SelectionChanged"/>
                </Grid>

                <Border Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="8" Margin="0,8,0,8">
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="主音量" VerticalAlignment="Center"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding VolumeText}" Foreground="{StaticResource SecondaryTextBrush}"/>
                        </DockPanel>
                        <Slider Minimum="0" Maximum="1" Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ValueChanged="Volume_ValueChanged"/>
                        <DockPanel Margin="0,6,0,0" LastChildFill="False">
                            <TextBlock Text="输入电平" VerticalAlignment="Center"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding InputLevelText}" Foreground="{StaticResource SecondaryTextBrush}"/>
                        </DockPanel>
                        <ProgressBar Height="7" Minimum="0" Maximum="1" Value="{Binding InputLevel}" IsHitTestVisible="False"/>
                    </StackPanel>
                </Border>

                <Button Content="应用选中场景" Click="ApplySceneButton_Click" Height="38" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"/>
                <TextBlock Text="状态" Foreground="{StaticResource SecondaryTextBrush}" Margin="3,7,0,0"/>
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="3,1,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
